{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gudusoft.com/schemas/lineage-eval.v1.schema.json",
  "title": "lineage-eval.v1",
  "description": "Output of lineage-eval-cli; input of gsp-openmetadata-sidecar --from-lineage-json. Additive changes only within v1.",
  "type": "object",
  "required": [
    "contract",
    "procedures"
  ],
  "properties": {
    "contract": {
      "const": "lineage-eval.v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "input": {
      "enum": [
        "sql",
        "sharded"
      ],
      "description": "What was analysed: sql = .sql scripts (--sql-dir); sharded = a sqlflow-sharded bundle from sqlflow-exporter (--sharded-dir), whose names are as the exporter writes them (for SQL Server: databases, tables and table columns upper-cased)"
    },
    "dialect": {
      "type": "string"
    },
    "defaultDatabase": {
      "type": [
        "string",
        "null"
      ],
      "description": "--default-database of the run: fills in only the database names the scripts leave open (a script's USE and explicit names win); always null for a sharded bundle, whose modules carry their own database"
    },
    "settingsHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of input|dialect|defaultDatabase|encoding (absent values empty): reports produced with different settings differ here"
    },
    "parserVersion": {
      "type": "string"
    },
    "procedures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "status",
          "edges",
          "issues"
        ],
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "db.schema.name when known"
          },
          "moduleType": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceFile": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where the unit's SQL came from: file:<path>[#L<first>-<last>] for .sql input; sharded:<shard>:<offset>:<length> (a byte range of the bundle's source/<shard>.source.jsonl) for a sharded bundle; null for a module the bundle lists without a body"
          },
          "status": {
            "enum": [
              "OK",
              "PARTIAL",
              "FAILED"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "source",
                "target",
                "origin",
                "verification"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "COLUMN",
                    "ROW_LEVEL",
                    "TABLE",
                    "CONSTANT",
                    "CALL"
                  ],
                  "description": "Shape of the fact. COLUMN: table.column -> table.column (the only kind for OpenMetadata columnsLineage). ROW_LEVEL: exactly one endpoint is a column, the other a row set (WHERE/JOIN influence, COUNT(*)). TABLE: no column on either side. CONSTANT: target column computed from constants, source table is null. CALL: procedure calls procedure (object dependency, not data movement)."
                },
                "source": {
                  "$ref": "#/$defs/endpoint"
                },
                "target": {
                  "$ref": "#/$defs/endpoint"
                },
                "role": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "scan-core RoleClassifier: DIRECT, DERIVED, TRANSFORM, AGGREGATE, GROUP_BY, FILTER, JOIN, CONDITION, UNKNOWN; call rows: LOOKUP"
                },
                "indirect": {
                  "type": "boolean",
                  "description": "true exactly when role is GROUP_BY, FILTER, JOIN or CONDITION (enforced below): the source decides which rows/group/branch, it does not supply the value. May be omitted; a reader then derives it from role"
                },
                "transformation": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "statementIndex": {
                  "type": "integer"
                },
                "confidence": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "origin": {
                  "enum": [
                    "STATIC",
                    "DYNAMIC"
                  ],
                  "description": "STATIC: SQL written in the code; DYNAMIC: reconstructed from a statement the code builds at run time (EXEC(@sql), sp_executesql)"
                },
                "verification": {
                  "enum": [
                    "VERIFIED",
                    "UNVERIFIED"
                  ],
                  "description": "VERIFIED: a static fact, or a dynamic one whose endpoints scan-core resolved against the metadata. UNVERIFIED (dynamic only, enforced below): a candidate, reported apart and never pushed"
                }
              },
              "allOf": [
                {
                  "properties": {
                    "target": {
                      "$ref": "#/$defs/withTable"
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "origin"
                    ],
                    "properties": {
                      "origin": {
                        "const": "STATIC"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "verification": {
                        "const": "VERIFIED"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "COLUMN"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "source": {
                        "allOf": [
                          {
                            "$ref": "#/$defs/withTable"
                          },
                          {
                            "$ref": "#/$defs/withColumn"
                          }
                        ]
                      },
                      "target": {
                        "$ref": "#/$defs/withColumn"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "ROW_LEVEL"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "source": {
                        "$ref": "#/$defs/withTable"
                      }
                    },
                    "oneOf": [
                      {
                        "properties": {
                          "source": {
                            "$ref": "#/$defs/withColumn"
                          },
                          "target": {
                            "$ref": "#/$defs/noColumn"
                          }
                        }
                      },
                      {
                        "properties": {
                          "source": {
                            "$ref": "#/$defs/noColumn"
                          },
                          "target": {
                            "$ref": "#/$defs/withColumn"
                          }
                        }
                      }
                    ]
                  }
                },
                {
                  "if": {
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "TABLE"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "source": {
                        "allOf": [
                          {
                            "$ref": "#/$defs/withTable"
                          },
                          {
                            "$ref": "#/$defs/noColumn"
                          }
                        ]
                      },
                      "target": {
                        "$ref": "#/$defs/noColumn"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "CONSTANT"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "source": {
                        "allOf": [
                          {
                            "$ref": "#/$defs/noTable"
                          },
                          {
                            "$ref": "#/$defs/noColumn"
                          }
                        ]
                      },
                      "target": {
                        "$ref": "#/$defs/withColumn"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "CALL"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "source": {
                        "allOf": [
                          {
                            "$ref": "#/$defs/withTable"
                          },
                          {
                            "$ref": "#/$defs/noColumn"
                          }
                        ]
                      },
                      "target": {
                        "$ref": "#/$defs/noColumn"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "indirect"
                    ],
                    "properties": {
                      "indirect": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "role"
                    ],
                    "properties": {
                      "role": {
                        "enum": [
                          "GROUP_BY",
                          "FILTER",
                          "JOIN",
                          "CONDITION"
                        ]
                      }
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "role",
                      "indirect"
                    ],
                    "properties": {
                      "role": {
                        "enum": [
                          "GROUP_BY",
                          "FILTER",
                          "JOIN",
                          "CONDITION"
                        ]
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "indirect": {
                        "const": true
                      }
                    }
                  }
                }
              ]
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "stage": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "severity": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reasonCode": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "dynamicSql": {
            "type": "array",
            "description": "B2: the unit's dynamic SQL sites (EXEC(@sql), sp_executesql), in source order, each with its final status; absent when the unit has none. A site's line and column (where its statement starts in the unit's text) are, with the unit, its stable identity.",
            "items": {
              "type": "object",
              "required": [
                "line",
                "column",
                "status",
                "parameterSets"
              ],
              "properties": {
                "line": {
                  "type": "integer"
                },
                "column": {
                  "type": "integer"
                },
                "kind": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "GSP's site kind: EXEC_STRING, SP_EXECUTESQL, ..."
                },
                "gspStatus": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "GSP's analysis of the site on its own"
                },
                "status": {
                  "enum": [
                    "RESOLVED",
                    "PARTIAL",
                    "UNRESOLVED"
                  ],
                  "description": "Final status. RESOLVED: the statement is known on its own (every relationship GSP found for it is proven), or under every parameter set its callers pass, each giving facts the metadata confirms. PARTIAL: under some of those parameter sets. UNRESOLVED: otherwise. The statistics count this status."
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Why the site is not resolved on its own, and what its callers' parameter sets made of it; null when it is"
                },
                "parameterSets": {
                  "type": "array",
                  "description": "Each distinct set of literal arguments the unit's callers pass it, and what the site became under it (SDLP's RESOLVE_DYNAMIC)",
                  "items": {
                    "type": "object",
                    "required": [
                      "parameters",
                      "status",
                      "facts"
                    ],
                    "properties": {
                      "parameters": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        },
                        "description": "lower-cased parameter name -> the literal as written"
                      },
                      "callers": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "status": {
                        "type": "string",
                        "description": "RESOLVED: facts the metadata confirms; PARTIAL: facts, but part of the statement is still unknown; UNCONFIRMED: the statement is known, but none of its edges has both endpoints in the metadata; FAILED: GSP could not evaluate the procedure; otherwise GSP's status for the site"
                      },
                      "facts": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Edges the metadata confirms: origin DYNAMIC, verification VERIFIED"
                      },
                      "sql": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "The statement the site runs with these parameters, when GSP could build it (clipped at 2000 characters)"
                      },
                      "reason": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": [
        "table"
      ],
      "properties": {
        "database": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "table": {
          "type": [
            "string",
            "null"
          ],
          "description": "null only on the source of a CONSTANT fact"
        },
        "column": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "withTable": {
      "required": [
        "table"
      ],
      "properties": {
        "table": {
          "type": "string",
          "pattern": "\\S",
          "description": "must contain a non-whitespace character; the evaluator normalizes blank names to null"
        }
      }
    },
    "noTable": {
      "properties": {
        "table": {
          "type": "null"
        }
      }
    },
    "withColumn": {
      "required": [
        "column"
      ],
      "properties": {
        "column": {
          "type": "string",
          "pattern": "\\S",
          "description": "must contain a non-whitespace character; the evaluator normalizes blank names to null"
        }
      }
    },
    "noColumn": {
      "properties": {
        "column": {
          "type": "null"
        }
      }
    }
  }
}
